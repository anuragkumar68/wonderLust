<%layout("layouts/boilerplate")%>
<div class="row">
    <div class="col-5 offset-3">
    <h2>SinUp for Wonderlust</h2>
    <form method="POST" action="/signup" novalidate class="needs-validation">
      <div class="mb-3">
         <label for="username" class="form-label">Username:</label>
         <input name="username" id="username" class="form-control" required >    
         <div  class="valid-feedback"></div>
         <div class="invalid-feedback">enter username</div>   
      </div>
      <div class="mb-3">
         <label for="email" class="form-label">Email:</label>
         <input name="email" id="email" class="form-control" required >    
         <div  class="valid-feedback"></div>
         <div class="invalid-feedback">enter email</div>   
      </div>
      <div class="mb-3">
         <label for="password" class="form-label">password:</label>
         <input name="password" id="password" class="form-control" required type="password" >    
         <div  class="valid-feedback"></div>
         <div class="invalid-feedback">create password</div>   
      </div>
      <button class="btn btn-success offset-6">SignUp</button>
    </form>
    </div>
</div>